@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 150
skinparam ArrowColor #334155
skinparam classBackgroundColor #EFF6FF
skinparam stateBackgroundColor #EFF6FF
skinparam activityBackgroundColor #EFF6FF
hide empty members
title Билет 6
class Книга {
-ISBN: String
-название: String
+найтиЭкземпляр()
}
class Экземпляр {
-инвентарныйНомер: String
-статус: String
+выдать()
+вернуть()
}
class Читатель {
-номерБилета: String
-ФИО: String
+оформитьВыдачу()
}
class Выдача {
-датаВыдачи: Date
-срокВозврата: Date
-датаВозврата: Date [0..1]
+закрыть()
}
Книга "1" *-- "0..*" Экземпляр
Читатель "1" -- "0..*" Выдача
Экземпляр "1" -- "0..*" Выдача
note bottom of Выдача
{Для экземпляра не более
одной незакрытой выдачи}
end note
@enduml
